{
  "name": "llmwiki",
  "displayName": "LLM Wiki",
  "description": "Interactive wiki browsing powered by LLM maintenance",
  "version": "1.0.1",
  "publisher": "eag-rss",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/llmwiki",
    "directory": "packages/vscode"
  },
  "main": "./out/extension.js",
  "icon": "icon.png",
  "activationEvents": [
    "workspaceContains:.wiki/wiki/index.md",
    "onCommand:llmwiki.init",
    "onView:entities",
    "onView:concepts",
    "onView:rawSources",
    "onView:backlinks",
    "onView:lintFindings"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "llmwiki",
        "label": "LLM Wiki"
      }
    ],
    "chatSkills": [
      {
        "path": "./out/chat/skills/wiki-ask/SKILL.md",
        "when": "llmwiki.isWikiWorkspace"
      },
      {
        "path": "./out/chat/skills/wiki-research/SKILL.md",
        "when": "llmwiki.isWikiWorkspace"
      },
      {
        "path": "./out/chat/skills/wiki-ingest/SKILL.md",
        "when": "llmwiki.isWikiWorkspace"
      },
      {
        "path": "./out/chat/skills/wiki-save/SKILL.md",
        "when": "llmwiki.isWikiWorkspace"
      },
      {
        "path": "./out/chat/skills/wiki-fix/SKILL.md",
        "when": "llmwiki.isWikiWorkspace"
      }
    ],
    "chatAgents": [
      {
        "path": "./out/chat/agents/wiki-librarian.agent.md",
        "when": "llmwiki.isWikiWorkspace"
      }
    ],
    "chatInstructions": [
      {
        "path": "./out/chat/instructions/llmwiki.instructions.md",
        "when": "llmwiki.isWikiWorkspace"
      }
    ],
    "commands": [
      {
        "command": "llmwiki.init",
        "title": "LLM Wiki: Initialize Wiki"
      },
      {
        "command": "llmwiki.ingest",
        "title": "LLM Wiki: Ingest Files or Folder",
        "icon": "$(add)"
      },
      {
        "command": "llmwiki.query",
        "title": "LLM Wiki: Query Wiki"
      },
      {
        "command": "llmwiki.status",
        "title": "LLM Wiki: Show Status"
      },
      {
        "command": "llmwiki.openPage",
        "title": "LLM Wiki: Open Page"
      },
      {
        "command": "llmwiki.refresh",
        "title": "LLM Wiki: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "llmwiki.fix",
        "title": "LLM Wiki: Fix Issues",
        "icon": "$(wand)"
      },
      {
        "command": "llmwiki.lint",
        "title": "LLM Wiki: Run Lint",
        "icon": "$(checklist)"
      },
      {
        "command": "llmwiki.fixWithCopilot",
        "title": "LLM Wiki: Fix Remaining Issues with Copilot",
        "icon": "$(sparkle)"
      },
      {
        "command": "llmwiki.search",
        "title": "LLM Wiki: Search Wiki",
        "icon": "$(search)"
      },
      {
        "command": "llmwiki.searchRaw",
        "title": "LLM Wiki: Search Sources",
        "icon": "$(search)"
      },
      {
        "command": "llmwiki.removeSource",
        "title": "LLM Wiki: Remove Source",
        "icon": "$(trash)"
      },
      {
        "command": "llmwiki.selectModel",
        "title": "LLM Wiki: Select Model",
        "icon": "$(sparkle)"
      },
      {
        "command": "llmwiki.scanRaw",
        "title": "LLM Wiki: Scan Sources for New Files",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "llmwiki-explorer",
          "title": "LLM Wiki",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "llmwiki-explorer": [
        {
          "id": "entities",
          "name": "Entities"
        },
        {
          "id": "concepts",
          "name": "Concepts"
        },
        {
          "id": "rawSources",
          "name": "Raw Sources",
          "canSelectMany": true
        },
        {
          "id": "backlinks",
          "name": "Backlinks"
        },
        {
          "id": "lintFindings",
          "name": "Lint Findings"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "llmwiki.search",
          "when": "view =~ /^(entities|concepts)$/ && llmwiki.isWikiWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "llmwiki.searchRaw",
          "when": "view == rawSources && llmwiki.isWikiWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "llmwiki.ingest",
          "when": "view == rawSources && llmwiki.isWikiWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "llmwiki.fix",
          "when": "view == rawSources && llmwiki.isWikiWorkspace",
          "group": "navigation@3"
        },
        {
          "command": "llmwiki.refresh",
          "when": "view =~ /^(entities|concepts|rawSources)$/ && llmwiki.isWikiWorkspace",
          "group": "navigation@4"
        },
        {
          "command": "llmwiki.lint",
          "when": "view == lintFindings && llmwiki.isWikiWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "llmwiki.fix",
          "when": "view == lintFindings && llmwiki.isWikiWorkspace",
          "group": "navigation@2"
        },
        {
          "command": "llmwiki.fixWithCopilot",
          "when": "view == lintFindings && llmwiki.hasLintFindings",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "llmwiki.removeSource",
          "when": "viewItem == rawSource",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "llmwiki.ingest",
          "when": "llmwiki.isWikiWorkspace",
          "group": "7_modification@1"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rawSources",
        "contents": "Please open a folder to use LLM Wiki.",
        "when": "llmwiki.noFolder"
      },
      {
        "view": "rawSources",
        "contents": "No wiki found in this workspace.\n[Initialize LLM Wiki](command:llmwiki.init)",
        "when": "!llmwiki.noFolder && !llmwiki.isWikiWorkspace"
      }
    ],
    "configuration": {
      "title": "LLM Wiki",
      "properties": {
        "llmwiki.modelFamily": {
          "type": "string",
          "default": "claude-opus-4.6",
          "description": "Preferred GitHub Copilot model family for LLM-powered ingestion. Run \"LLM Wiki: Select Model\" from the Command Palette to pick from installed Copilot models. Falls back to any available Copilot model when the requested family is unavailable. Leave blank to always use the first available Copilot model."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:prod": "node esbuild.config.mjs --production",
    "lint": "tsc --noEmit",
    "watch": "node esbuild.config.mjs --watch",
    "prepackage": "npm run build:prod",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@llmwiki/core": "*",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.109.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.1",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "typescript": "^5.4.0"
  }
}
